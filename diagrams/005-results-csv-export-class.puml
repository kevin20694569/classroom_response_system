@startuml 005-results-csv-export-class
' 子功能 005：搶答結果匯出 CSV — 類別圖（只列出本子功能新增或修改的成員；其餘沿用 001～004 類別圖）
skinparam defaultFontName "PingFang TC"
hide empty members
title 005 搶答結果匯出 CSV — 類別圖 (Class Diagram)

package "shared（契約）" {
  class Submission <<沿用>> {
    +id: string
    +questionNumber: number
    +groupId: number
    +answers: BlankAnswer[]
    +sequence: number
    +receivedAt: string
    +submitterNickname: string | null
  }
  class Question <<沿用>> {
    +number: number
    +kind: single | group
    +blanks: { label: string | null }[]
  }
  class QuestionResult <<沿用>> {
    +questionNumber: number
    +winner: Submission | null
  }
  class csvExport <<module, 新增>> {
    +CSV_EXPORT_PATH = /api/session/export.csv
    +CSV_EXPORT_NOT_CLOSED_MESSAGE = 「搶答結束後才能匯出 CSV。」
    +CSV_HEADERS = 題號、子題、組別、送出者暱稱、答案、搶答順位、送出時間、是否搶答成功
    +CSV_NO_ANSWER_TEXT = 「無人作答」
  }
}

package "server（領域層）" {
  interface "ResultExporter<TReport = ExportReport>" as ResultExporter {
    +export(session, results, mode): Promise<TReport>（修改：加上泛型）
  }
  class GuidedNotesExporter <<沿用>> {
    +export(session, results, mode): Promise<ExportReport>
  }
  class CsvResultExporter <<新增>> {
    -ranking: RankingStrategy
    +export(session, results, _mode): Promise<CsvExport>（忽略 mode）
  }
  note right of CsvResultExporter
    非 CLOSED 由服務層先擋下；
    搶答成功 = results 的 winner.id；
    順位 = ranking.rank() 的位置
  end note
  class CsvExport {
    +fileName: string（搶答結果_YYYYMMDD-HHmm.csv）
    +asciiFileName: string（results_YYYYMMDD-HHmm.csv）
    +content: string（BOM + 表頭 + 各列，CRLF）
    +rowCount: number
  }
  class ResultRow {
    +questionNumber: number
    +blankLabel: string | null（單題、無人作答為 null）
    +groupLabel: string | null（「第 N 組」）
    +submitterNickname: string | null
    +answer: string（無人作答為「無人作答」）
    +rankLabel: string | null（「第 N 名」）
    +submittedAt: string | null（YYYY/MM/DD HH:mm:ss.SSS）
    +isWinner: 是 | 否 | null
  }
  class resultRows <<module>> {
    +buildResultRows(session, ranking, results): ResultRow[]
    -blankLabelOf(question, position): string（無標記時「（序號）」）
    -rowsOfSubmission(question, submission, rankLabel, isWinner): ResultRow[]
  }
  note right of resultRows
    依題號由小到大；同題依順位；
    題組每筆送出依子題順序拆列、相鄰；
    無人作答的題目恰好一列（FR-006～FR-008）
  end note
  class csvEncoder <<module>> {
    +encodeCsv(headers, rows): string（UTF-8 BOM、CRLF）
    +encodeField(value): string
    -neutralizeFormula(value): string（= + - @ Tab CR 開頭加 '）
    -quoteIfNeeded(value): string（含逗號、引號、換行或前後空白時加雙引號）
  }
  class csvFileName <<module>> {
    +csvFileName(openedAt): string
    +csvAsciiFileName(openedAt): string
  }
  class formatSubmittedAt <<function, 沿用>> {
    +formatSubmittedAt(iso): string
  }
  interface RankingStrategy <<沿用>> {
    +rank(submissions): Submission[]
  }
  class QuizSessionService {
    +exportCsv(): Promise<CsvExport>（新增：mutate 內讀取並回傳原 session；\n非 CLOSED 丟 INVALID_TRANSITION；log 只記列數）
    +exportResults(mode)（沿用：Guided Notes）
  }
  class QuizSessionServiceDeps {
    +exporter?: ResultExporter（沿用）
    +csvExporter?: ResultExporter<CsvExport>（新增，預設 CsvResultExporter）
  }

  GuidedNotesExporter ..|> ResultExporter
  CsvResultExporter ..|> ResultExporter : TReport = CsvExport
  CsvResultExporter --> RankingStrategy
  CsvResultExporter ..> resultRows
  CsvResultExporter ..> csvEncoder
  CsvResultExporter ..> csvFileName
  CsvResultExporter ..> CsvExport : 產生
  QuizSessionService ..> QuizSessionServiceDeps
  QuizSessionService --> CsvResultExporter : csvExporter
  resultRows ..> Submission : 讀取
  resultRows ..> Question : 讀取
  resultRows ..> QuestionResult : 讀取 winner
  resultRows ..> formatSubmittedAt
  resultRows ..> RankingStrategy : 每題排序
  resultRows ..> ResultRow : 產生
  resultRows ..> csvExport
  csvEncoder ..> ResultRow
}

package "server（傳輸層）" {
  class sessionRoutes {
    +GET /api/session/export.csv（新增：requireTeacher；\ntext/csv; charset=utf-8；Cache-Control: no-store；\nContent-Disposition: filename + filename*）
  }
  sessionRoutes ..> QuizSessionService
  sessionRoutes ..> csvExport
}

package "web（老師端）" {
  class CsvExportPanel <<新增>> {
    +view: TeacherView
    -busy: boolean
    -message: string | null
    -error: DisplayError | null
    +handleDownload(): apiDownload → saveBlob
  }
  class http <<module>> {
    +apiDownload(path): Promise<{ blob, fileName }>（新增）
  }
  class contentDisposition <<module, 新增>> {
    +fileNameFromContentDisposition(header): string | null
  }
  class download <<module, 新增>> {
    +saveBlob(blob, fileName): void
  }
  class TeacherDashboard {
    （新增掛載 CsvExportPanel，ExportPanel 不變）
  }
  TeacherDashboard --> CsvExportPanel
  CsvExportPanel ..> http
  CsvExportPanel ..> download
  http ..> contentDisposition
  CsvExportPanel ..> csvExport
}
@enduml
