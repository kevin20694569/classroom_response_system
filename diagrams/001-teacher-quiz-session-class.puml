@startuml 001-teacher-quiz-session-class
' 子功能 001：使用者角色與老師端搶答活動管理 — 類別圖（已依實作驗證，見 specs/001-teacher-quiz-session/diagram-verification.md）
skinparam defaultFontName "PingFang TC"
hide empty members
title 001 老師端搶答活動管理 — 類別圖 (Class Diagram)

package "使用者與角色" {
  enum Role {
    teacher
    student
  }
  abstract class User {
    +role: Role
  }
  class TabIdentity {
    +role: Role
    +groupId: GroupId（學生）
    +activityId: string（學生）
    +issuedAt: string
    +expiresAt: string
  }
  class AuthService {
    +loginAsTeacher(password: string): AuthResponse
    +joinAsStudent(groupId: number, session: QuizSession): AuthResponse
    +resolve(token: string, currentActivityId: string | null): TabIdentity | null
  }
  class RoleGuard <<functions>> {
    +requireTeacher(identity): TeacherIdentity
    +requireStudent(identity): StudentIdentity
  }
  TabIdentity --> User : 以簽章 token 表示
  AuthService ..> TabIdentity : 簽發 / 驗證
  RoleGuard ..> TabIdentity
  class Teacher {
  }
  class Student {
    +groupId: GroupId
  }
  class Group {
    +id: GroupId
    +name: string
  }
  User <|-- Teacher
  User <|-- Student
  User --> Role
  Student "*" --> "1" Group : 隸屬
}

package "搶答活動" {
  enum SessionStatus {
    NOT_IMPORTED
    READY
    OPEN
    CLOSED
  }
  class QuizSession <<data>> {
    +activityId: string | null
    +status: SessionStatus
    +source: GuidedNotesRef | null
    +groups: Group[]
    +questions: Question[]
    +submissions: Submission[]
    +nextSequence: number
    +openedAt: string | null
    +closedAt: string | null
    +lastExport: LastExport | null
  }
  class QuizSessionStateMachine <<functions>> {
    +initialSession(): QuizSession
    +assertTransition(status, action, options): void
  }
  class QuizSessionService {
    +init(): void
    +getSession(): QuizSession
    +onChange(listener): unsubscribe
    +mutate(fn): T
    +importQuestions(options: ImportOptions): QuizSession
    +open(): QuizSession
    +close(): QuizSession
    +exportResults(): ExportResult
  }
  class SubmissionService {
    +submit(groupId: GroupId, request: SubmitRequest): SubmitResponse
  }
  class AsyncMutex {
    +runExclusive(fn): T
  }
  class Question {
    +number: number
    +order: number
    +kind: single | group
    +blanks: Blank[]
  }
  class Blank {
    +index: number
    +label: string | null
    +location: CellLocation
  }
  class CellLocation {
    +sheetTitle: string
    +rowIndex: number
    +columnIndex: number
  }
  class Submission {
    +id: string
    +groupId: GroupId
    +questionNumber: number
    +answers: BlankAnswer[]
    +sequence: number
    +receivedAt: string
  }
  class BlankAnswer {
    +blankIndex: number
    +text: string
  }
  note bottom of BlankAnswer
    去除前後空白後 1～200 字；
    任一格不符則整筆拒絕（FR-017a）
  end note
  class QuestionResult {
    +questionNumber: number
    +winner: Submission | null
  }
  QuizSession --> SessionStatus
  QuizSession "1" *-- "*" Question
  QuizSession "1" o-- "2..20" Group
  QuizSession "1" *-- "*" Submission
  Question "1" *-- "1..*" Blank
  Blank --> CellLocation
  Submission "1" *-- "1..*" BlankAnswer
  Submission "*" --> "1" Question
  Submission "*" --> "1" Group
  QuestionResult --> Question
  QuestionResult --> "0..1" Submission : 搶答成功
  QuizSessionService --> QuizSession : 唯一持有者
  QuizSessionService ..> QuizSessionStateMachine
  QuizSessionService *-- AsyncMutex
  SubmissionService --> QuizSessionService : mutate
}

package "Guided Notes 處理" {
  class GuidedNotesRef {
    +spreadsheetId: string
    +sheetTitle: string
  }
  class SpreadsheetRef {
    +spreadsheetId: string
  }
  class SpreadsheetSnapshot {
    +sheets: SheetGrid[]
  }
  class SheetGrid {
    +sheetTitle: string
    +cells: string[][]
    +merges: MergeRange[]
  }
  class GuidedNotesParser <<functions>> {
    +parseGuidedNotes(snapshot: SpreadsheetSnapshot): ParsedGuidedNotes
    -selectSheet(snapshot): SheetGrid
    +parseQuestionNumber(raw): number | empty | invalid
    +readBlankMarker(text): BlankMarker | null
  }
  SpreadsheetSnapshot "1" *-- "*" SheetGrid
  class ParsedGuidedNotes {
    +sheetTitle: string
    +questions: Question[]
  }
  class ErrorDetail {
    +code: string
    +message: string
    +sheetTitle?: string
    +row?: number
    +column?: string
    +questionNumber?: number
  }
  interface GuidedNotesGateway {
    +read(ref: SpreadsheetRef): SpreadsheetSnapshot
    +writeCells(ref: SpreadsheetRef, writes: CellWrite[]): void
  }
  class GoogleSheetsGateway
  class FakeGuidedNotesGateway
  GuidedNotesGateway <|.. GoogleSheetsGateway
  GuidedNotesGateway <|.. FakeGuidedNotesGateway
  GuidedNotesParser ..> SheetGrid : 讀取
  GuidedNotesParser ..> ParsedGuidedNotes : 產生
  GuidedNotesParser ..> ErrorDetail : 驗證失敗時（全部回報）
  QuizSessionService ..> GuidedNotesParser
  QuizSessionService --> GuidedNotesGateway
}

package "擴充點（核心只實作預設）" {
  interface RankingStrategy {
    +rank(submissions: Submission[]): Submission[]
  }
  class FirstSubmissionStrategy
  RankingStrategy <|.. FirstSubmissionStrategy
  interface ResultExporter {
    +export(session: QuizSession, results: QuestionResult[]): ExportReport
  }
  class GuidedNotesExporter
  class ExportPlanner <<functions>> {
    +planExport(session, results, fresh: ParsedGuidedNotes): ExportPlan
  }
  ResultExporter <|.. GuidedNotesExporter
  GuidedNotesExporter --> GuidedNotesGateway
  GuidedNotesExporter ..> GuidedNotesParser : 匯出前重新定位
  GuidedNotesExporter ..> ExportPlanner
  QuizSessionService --> ResultExporter
  QuizSessionService --> RankingStrategy
}

package "資料保存" {
  interface SessionRepository {
    +load(): QuizSession | null
    +save(session: QuizSession): void
  }
  class LocalSessionRepository
  SessionRepository <|.. LocalSessionRepository
}
SessionRepository ..> QuizSession
QuizSessionService --> SessionRepository

note bottom of LocalSessionRepository
  每次狀態轉換或收件成功後先保存再回覆；
  伺服器重啟後載入恢復（FR-028）
end note

class VisibilityPolicy <<functions>> {
  +toPublicView(session): PublicView
  +toStudentView(session, groupId, ranking): StudentView
  +toTeacherView(session, ranking): TeacherView
}
VisibilityPolicy ..> QuizSession

QuizSession --> GuidedNotesRef

note bottom of QuizSessionStateMachine
  狀態轉換（其餘一律拒絕）：
  NOT_IMPORTED -> READY（匯入）
  READY -> READY（重新匯入）
  READY -> OPEN（開啟，全部題目同時開放）
  OPEN -> CLOSED（結束）
  CLOSED -> READY（老師確認後匯入新文件）
  不允許 CLOSED -> OPEN（不可重新開啟）
end note

note right of Question
  依版面結構判斷（FR-009a）：
  單題：同一題號只涵蓋 1 個作答格
  題組：同一題號（合併或相鄰列重複）涵蓋多個作答格，
  為一個搶答單位，送出須包含全部子題
  label：原有「（n）」標記，沒有則為 null
  題號接受 1 / 1. / 1、/ Q1 / 第1題 / 全形（FR-007a）
end note

note bottom of FirstSubmissionStrategy
  順位依伺服器處理順序（sequence），
  不採用客戶端時間
end note
@enduml
