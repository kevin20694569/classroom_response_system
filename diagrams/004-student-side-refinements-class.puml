@startuml 004-student-side-refinements-class
' 子功能 004：學生端細修 — 類別圖（只列出本子功能新增或修改的成員；其餘沿用 001～003 類別圖）
skinparam defaultFontName "PingFang TC"
hide empty members
title 004 學生端細修 — 類別圖 (Class Diagram)

package "shared（契約）" {
  class StudentJoinRequest {
    +groupId: number
    +nickname: string（新增：去除前後空白後 1～20 字）
  }
  class StudentIdentity <<token 與 IdentitySummary>> {
    +role: student
    +groupId: number
    +activityId: string
    +expiresAt: string
    +memberId: string（新增：同一分頁固定，重新整理不變）
    +nickname: string（新增）
  }
  class GroupHeadcount {
    +groupId: number
    +memberCount: number
  }
  class GroupMember {
    +memberId: string
    +nickname: string
  }
  class StudentQuestionView {
    +number: number
    +kind: single | group
    +blankCount: number
    +blankLabels: (string | null)[]
    +content: QuestionTexts | null（只在 OPEN / CLOSED）
  }
  class QuestionTexts {
    +prompt: string | null（null 代表文件沒有敘述）
    +blankPrompts: (string | null)[]
  }
  StudentQuestionView *-- "0..1" QuestionTexts
  class Submission {
    +submitterNickname: string | null（新增：舊資料為 null）
  }
  class OwnSubmission {
    +submitterNickname: string | null（新增：本組都看得到）
  }
  class ResultView {
    +submitterNickname: string | null（新增：只在 CLOSED，搶答成功答案的送出者）
  }
  class PublicView {
    +headcounts: GroupHeadcount[]（新增）
  }
  class StudentView {
    +headcounts: GroupHeadcount[]（新增）
    +members: GroupMember[]（新增：只有本組，依加入先後）
    +questions: StudentQuestionView[]（修改）
  }
  class NicknameRules <<module>> {
    +NICKNAME_MAX_LENGTH = 20
    +NICKNAME_RULE_MESSAGE: string
    +NicknameSchema（去除前後空白、1～20 字、無控制字元）
  }
  StudentView *-- "0..*" GroupHeadcount
  StudentView *-- "0..*" GroupMember
  StudentView *-- "0..*" StudentQuestionView
  StudentView *-- "0..*" OwnSubmission
  StudentView *-- "0..*" ResultView
  PublicView *-- "0..*" GroupHeadcount
  StudentJoinRequest ..> NicknameRules
}

package "server" {
  class GroupRoster {
    -entries: Map<memberId, RosterEntry>
    -leftMemberIds: Set<memberId>
    +leave(memberId, groupId): void（只在 READY，由 HttpApi 呼叫）
    +hasLeft(memberId): boolean
    +connected(memberId, groupId, nickname): void
    +disconnected(memberId): void（連線歸零 30 秒後才移除）
    +headcounts(groups): GroupHeadcount[]
    +membersOf(groupId): GroupMember[]
    +clear(): void
    +onChange(listener): () => void
  }
  class RosterEntry {
    +memberId: string
    +groupId: number
    +nickname: string
    +joinedSeq: number
    +connections: number
    +removeTimer: Timer | null
  }
  GroupRoster *-- "0..*" RosterEntry
  class VisibilityPolicy <<module>> {
    +toPublicView(session, roster): PublicView
    +toStudentView(session, groupId, strategy, roster): StudentView
  }
  note right of VisibilityPolicy
    READY 以前 content = null；
    members 只放 groupId 的組員；
    OPEN 時只給本組送出者，CLOSED 才給搶答成功答案的送出者
  end note
  class SubmissionService {
    +submit(submitter, request): SubmitResponse（送出者取自 token 的 nickname）
  }
  SubmissionService ..> Submission : 保存
  class exportPlan <<module>> {
    +planExport(session, results, fresh, mode): ExportPlan
    -attribution(winner): 〔第 N 組｜暱稱｜時間〕（修改）
    -resultColumnWrites(): 組別欄、時間欄、送出者欄（新增一欄）
  }
  exportPlan ..> Submission : 讀取 submitterNickname
  VisibilityPolicy ..> GroupRoster : 讀取
  VisibilityPolicy ..> StudentView : 產生
  VisibilityPolicy ..> PublicView : 產生
}

package "web（老師端）" {
  class SubmissionBoard {
    +submissions: Submission[]（每筆顯示送出者暱稱）
  }
}

package "web（學生端）" {
  class StudentPage {
    -nickname: string | null
    -editingNickname: boolean
    -leaveError: string | null
    -identity: StudentIdentity | null
    -view: StudentView | PublicView | null
    +render(): 暱稱 / 選組 / 作答 / 結果
  }
  class NicknamePanel {
    +initial: string | null
    +onConfirm(nickname): void
    +onCancel?(): void（修改暱稱時）
    -value: string
    -error: string | null
  }
  class randomNickname <<function>> {
    +randomNickname(exclude?): string（3～10 個英文字母，faker 英文語系）
  }
  class NicknameStore <<module>> {
    +load(): string | null
    +save(nickname): void
  }
  class JoinGroupPanel {
    +groups: Group[]
    +headcounts: GroupHeadcount[]（新增）
    +nickname: string（新增）
    +onJoin(groupId): void
    +onEditNickname(): void（新增）
  }
  class GroupMemberList {
    +members: GroupMember[]
    +selfMemberId: string
  }
  class QuestionContent {
    +number: number
    +kind: single | group
    +blankCount: number
    +prompt: string | null
    +blanks: {label, prompt}[]
    +titleAs?: p | h2
    +hideTitle?: boolean
    +renderBlank?(index): ReactNode（學生端插入輸入欄或結果）
  }
  class QuestionAnswerForm {
    +question: StudentQuestionView（修改）
  }
  class useStudentAuth <<hook>> {
    +join(groupId, nickname): Promise<void>（修改）
    +leave(): Promise<void>（修改：先呼叫離開 API）
  }
  StudentPage --> NicknamePanel
  StudentPage --> JoinGroupPanel
  StudentPage --> GroupMemberList
  class StudentResultBoard {
    +questions: StudentQuestionView[]（修改：顯示敘述與送出者）
  }
  StudentPage --> StudentResultBoard
  StudentPage ..> NicknameStore
  NicknamePanel ..> randomNickname
  NicknamePanel ..> NicknameRules
  QuestionAnswerForm ..> QuestionContent
  StudentResultBoard ..> QuestionContent
}
@enduml
