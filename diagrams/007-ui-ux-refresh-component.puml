@startuml 007-ui-ux-refresh-component
' 子功能 007：介面視覺與互動體驗改版 — 組件圖（灰色為沿用 001～006、本子功能不改動的元件；伺服器端完全不變）
skinparam defaultFontName "PingFang TC"
skinparam componentStyle uml2
title 007 介面視覺與互動體驗改版 — 組件圖 (Component Diagram)

actor "老師" as TeacherActor
actor "學生（各組）" as StudentActor

node "瀏覽器分頁（老師端 / 學生端 / 首頁）" as Browser {
  package "ui（新增：全站共用視覺層）" as UiKit {
    component "VisualTheme\nindex.css @theme（背景、卡片、Nunito 字型、keyframes、減少動態）\n+ theme.ts 色票（組別、階段、金銀銅）（FR-001～003）" as Theme
    component "Button\n主要 / 次要 / 危險；\n移上、按下、停用、處理中（FR-004）" as Button
    component "Icon\n包裝 lucide-react（打包進程式）；\n同一意義同一圖示、aria-hidden（FR-006、FR-026）" as Icon
    component "groupIdentity\n組別編號 → 顏色 + 圖示\n2～20 組兩兩不同（FR-007、FR-008）" as GroupIdentity
    component "GroupBadge\n顏色 + 圖示 + 組別名稱\n（showName=false：只有圓形標記）" as GroupBadge
    component "SectionHeading / styles\n區塊標題、卡片與輸入欄的共用 class" as Styles
    component "phaseStyle\n階段 → 強調色、圖示\n（FR-010、FR-011）" as PhaseStyle
    component "PhaseTransitionToast\n「搶答開始！」「搶答結束」\n2 秒內消失、不攔截操作（FR-012～014）" as Toast
    component "usePhaseTransition\n只在同一分頁看到階段改變時觸發；\n首次載入 / 重整 / 重連不觸發" as PhaseHook
    component "RankMedal\n第 1～3 名金銀銅、獎盃（FR-017、FR-018）" as Medal
    component "Celebration\n本組搶到題目時播一次；疊在上方、\n不攔截點擊、3 秒內結束（FR-019）" as Celebration
    component "ResultReveal\n老師端結果揭曉：每題搶答成功組別 + 暱稱 + 答案；\n按「關閉」回主畫面（FR-029）" as Reveal
    component "useNewSubmissionHighlight\n只標記本分頁收到推播後新增的送出；\n首次載入 / 重整不播放（FR-030）" as NewHighlight
    component "EmptyState / LoadingState\n插圖 + 既有說明文字 + 循環動態（FR-020）" as EmptyState
    component "ConnectionBanner\n連線中斷 / 已重新連線（FR-021）" as ConnBanner
    component "useReducedMotion\n系統「減少動態效果」設定（FR-023）" as ReducedMotion
  }

  package "頁面（改呈現，不改行為：FR-027）" as Pages {
    component "HomePage\n系統名稱、說明、兩個入口卡片（FR-005）" as Home
    component "TeacherLoginPage / TeacherDashboard /\nImportPanel / SessionControls / ExportPanel /\nCsvExportPanel" as TeacherPages
    component "SubmissionBoard\n每筆送出加 GroupBadge、RankMedal；\n新送出滑入並亮起（1 秒內）" as SubmissionBoard
    component "GroupOverviewPanel / MemberAnswerTags\n各組加 GroupBadge" as OverviewPanel
    component "StudentPage（切換提示、慶祝效果、連線橫幅）/\nNicknamePanel / JoinGroupPanel /\nPhaseBanner（底色 = 本組顏色，內含階段標籤、連線中斷膠囊）/\nGroupMemberList（GroupBadge + 本組顏色邊條）（FR-009、FR-009a）" as StudentPages
    component "AnswerSheet / QuestionAnswerForm\n送出中、送出成功動畫（FR-015）" as AnswerSheet
    component "StudentResultBoard\n獎盃標示、組別標記" as ResultBoard
    component "AnswerLines\n每個子題一行「（n）答案」\n（SubmissionBoard、ResultReveal 共用）" as AnswerLines
    component "SessionTimer\n進行中脈動、結束定格（FR-016）" as Timer
    component "StatusBadge\n套用 phaseStyle" as StatusBadge
  }

  component "useSessionState / useStudentAuth" as SessionHook #EEEEEE
}

package "shared（前後端共用契約，不變）" as Shared #EEEEEE {
  component "SessionStatus / Group / groupName /\nSESSION_STATUS_LABEL / Submission" as Contracts #EEEEEE
}

node "本機伺服器（不變）" as Server #EEEEEE {
  component "HttpApi / RealtimeGateway /\nVisibilityPolicy / 領域層" as ServerAll #EEEEEE
}

TeacherActor --> Home
TeacherActor --> TeacherPages
StudentActor --> Home
StudentActor --> StudentPages

Pages ..> Theme : 套用
Pages ..> Button
Pages ..> Icon
Pages ..> EmptyState
Pages ..> ConnBanner
StudentPages --> GroupBadge
SubmissionBoard --> GroupBadge
SubmissionBoard --> Medal
SubmissionBoard --> NewHighlight
TeacherPages --> Reveal : 本分頁看到 OPEN → CLOSED
Reveal --> GroupBadge
Reveal --> PhaseHook
Reveal ..> ReducedMotion
NewHighlight ..> ReducedMotion
OverviewPanel --> GroupBadge
ResultBoard --> GroupBadge
ResultBoard --> Medal
StudentPages --> Celebration : 提示消失後播放
SubmissionBoard --> AnswerLines
Reveal --> AnswerLines
Pages ..> Styles
TeacherPages --> ConnBanner
StudentPages --> ConnBanner
GroupBadge --> GroupIdentity
GroupBadge --> Icon
StatusBadge --> PhaseStyle
StudentPages --> StatusBadge
TeacherPages --> StatusBadge
StudentPages --> Toast
TeacherPages --> Toast
Toast --> PhaseHook
Toast --> PhaseStyle
Celebration --> PhaseHook : 當場看到 OPEN → CLOSED 才播
Toast ..> ReducedMotion
Celebration ..> ReducedMotion
EmptyState ..> ReducedMotion
AnswerSheet ..> ReducedMotion

PhaseHook --> SessionHook : 階段（status）
Pages --> SessionHook
SessionHook --> ServerAll : 既有 HTTP / 即時推播
GroupIdentity ..> Contracts : 組別編號
PhaseStyle ..> Contracts : SessionStatus
@enduml
