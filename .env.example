# 課堂搶答系統設定範例
# 複製為 .env 後填入真實值；.env 不納入版控（constitution 原則 VIII）。
# 伺服器啟動時會驗證這些變數，缺少或格式錯誤會拒絕啟動。

# 老師端登入密碼（至少 8 字）
TEACHER_PASSWORD=

# 簽章分頁身分 token 用的隨機字串（至少 32 字），可用 `openssl rand -hex 32` 產生
SESSION_SECRET=

# Google 服務帳號金鑰 JSON 的完整路徑（請放在 repo 以外，不要用 ~）
# 例如 /Users/<你的帳號>/.config/classroom-response-system/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# 選填：伺服器埠號，預設 3000
PORT=3000

# 選填：活動狀態保存目錄，預設 ./data（已被 .gitignore 排除）
DATA_DIR=./data
